# Copie para .env. Os valores batem com deploy/compose/docker-compose.yml.
NODE_ENV=development
API_PORT=3001

# Container do PostgreSQL (o dono do banco)
POSTGRES_USER=datapulse
POSTGRES_PASSWORD=datapulse
POSTGRES_DB=datapulse

# Usuário da API: sem superpoderes, sujeito ao Row-Level Security.
# Criado por "pnpm db:setup" com o usuário e a senha desta linha.
DATABASE_URL=postgres://datapulse_api:datapulse_api@localhost:5432/datapulse
# Usuário dono do banco: só para migrações
MIGRATION_DATABASE_URL=postgres://datapulse:datapulse@localhost:5432/datapulse

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=datapulse
S3_SECRET_KEY=datapulse-secret
S3_BUCKET_INCOMING=dp-incoming
S3_BUCKET_ARCHIVE=dp-archive

# Tokens de acesso. As chaves JWT_PRIVATE_KEY e JWT_PUBLIC_KEY
# são geradas por "pnpm keys:generate" direto no .env
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
